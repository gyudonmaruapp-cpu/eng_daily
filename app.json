{
  "expo": {
    "name": "英語名言 日めくりカレンダー",
    "slug": "eng-daily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "eng-daily",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gyudonmaru.engdaily",
      "appleTeamId": "KK84RZRLR8",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "名言カードを画像として写真に保存するために使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gyudonmaru.engdaily",
      "adaptiveIcon": {
        "backgroundColor": "#f3f2f2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#ec3013"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "名言カードを画像として写真に保存するために使用します。",
          "savePhotosPermission": "名言カードを画像として写真に保存するために使用します。"
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "この許可は、あなたの興味に合わせた広告を表示するために使われます。許可しなくてもアプリは通常どおり使えます。"
        }
      ]
    ]
  }
}
